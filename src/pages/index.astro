---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Agentes from '../components/Agentes.astro';
import Desarrollo from '../components/Desarrollo.astro';
import Proceso from '../components/Proceso.astro';
import Soporte from '../components/Soporte.astro';
import Tecnologias from '../components/Tecnologias.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Nekotech · Agentes de IA y software a medida para pymes"
  description="Agentes de IA que agendan citas y atienden tus canales, y software a medida (SaaS, ERP, CRM y apps) para pymes en Chile. Con soporte continuo."
>
  <Header />
  <main>
    <Hero />
    <Agentes />
    <Desarrollo />
    <Proceso />
    <Soporte />
    <Tecnologias />
    <Contacto />
  </main>
  <Footer />
</Base>
