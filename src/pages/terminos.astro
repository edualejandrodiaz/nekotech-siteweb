    title="Términos y Condiciones de Nekotech"
    updated="22 de septiembre del 2026"
  />
  <main class="legal-main" id="main-content">
    <nav class="legal-toc" aria-label="Índice de contenidos">
      <h2>Índice</h2>
      <ol>
        <li><a href="#introduccion">Introducción y aceptación</a></li>
        <li><a href="#responsable">Identificación del prestador</a></li>
        <li><a href="#descripcion">Descripción del Servicio</a></li>
        <li><a href="#elegibilidad">Elegibilidad y cuentas</a></li>
        <li><a href="#uso-aceptable">Uso aceptable</a></li>
        <li><a href="#naturaleza-ia">Naturaleza de las respuestas generadas por IA</a></li>
        <li><a href="#terceros">Servicios de terceros</a></li>
        <li><a href="#propiedad-intelectual">Propiedad intelectual</a></li>
        <li><a href="#servicios-contratados">Servicios de desarrollo contratados</a></li>
